# Every key Revenant reads, with an empty value and where to get one.

# neatlogs project key: https://app.neatlogs.com (project settings). neatlogs.init() reads it.
NEATLOGS_API_KEY=

# Model for claims and the warrant judgment: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opens the revert PR. Leave empty if `gh auth login` is already done.
GITHUB_TOKEN=
